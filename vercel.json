{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/blog/why-im-starting-an-ai-consulting-business-in-berks-county",
      "destination": "/blog/why-berksai-leads-with-ai-training",
      "permanent": true
    },
    {
      "source": "/blog/what-i-learned-helping-pennsylvania-businesses-implement-ai",
      "destination": "/blog/what-small-businesses-should-know-before-starting-with-ai",
      "permanent": true
    },
    {
      "source": "/blog/ai-tools-i-actually-use-every-day",
      "destination": "/blog/how-to-choose-ai-tools-for-your-business",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true
}
